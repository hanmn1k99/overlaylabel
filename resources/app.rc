#include <winver.h>

101 ICON "app.ico"

#ifdef _MSC_VER
1 24 "app.manifest"
#else
2 24 "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "minhhan.net"
            VALUE "FileDescription", "Overlay Label (Click-Through Always On Top)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "OverlayLabel"
            VALUE "LegalCopyright", "Copyright (C) 2026 minhhan.net"
            VALUE "OriginalFilename", "OverlayLabel.exe"
            VALUE "ProductName", "Overlay Label"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
